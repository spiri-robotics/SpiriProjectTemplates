# The revision history of the [[ project_name ]] documentation, a controlled
# document (spiri-docs, as for every Spiri manual).
#
# This file is the single source for the cover page, the PDF footer, the PDF
# filename, and the revision table in the document. Nothing else records the
# document's revision -- do not put one anywhere else, it will drift.
#
# The document's revision is not the software's version: the docs are revised
# when what they say changes, the software on every release. Each software
# release (a `vX.Y.Z` tag) attaches the PDF of whatever revision is current, and
# the PDF names its own revision -- and says DRAFT if it is one.
#
# Dates are unquoted ISO dates (YYYY-MM-DD). Quoting one makes it a string, and
# the build will reject it rather than guess at the format.

document_number: [[ document_number ]]
[% if audience == 'regulator' %]
# Regulator-facing: every revision must name an approver and an effective date.
# The build fails if either is missing.
regulator_facing: true
[% else %]
regulator_facing: false
[% endif %]
[% if distribution_statement %]
distribution_statement: [[ distribution_statement ]]
[% endif %]

revisions:
  - revision: "0.1"
    # Set this to the date of the initial draft.
    date: 2026-01-01
    summary: Initial draft.
    author: [[ author_name or 'Spiri Robotics' ]]
    # A draft is marked as one on the cover page, in the PDF footer, and in the
    # PDF filename, so a printed copy cannot be mistaken for an issued document.
    #
    # Remove this line to issue the revision.
[% if audience == 'regulator' %]
    # Because this document is regulator-facing, the build will then require
    # `approver` and `effective_date` below -- and will reject "TODO" as either.
[% endif %]
    draft: true
[% if audience == 'regulator' %]
    # approver: A. Person
    # effective_date: 2026-02-01
[% endif %]
