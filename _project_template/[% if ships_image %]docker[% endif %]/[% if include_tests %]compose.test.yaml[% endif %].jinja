# [[project_name]] Docker Compose - Tests
#
# Runs the test suite inside the image, to catch differences from local dev:
#   docker compose -f docker/compose.test.yaml run --rm test

services:
  test:
    build:
      context: ..
      dockerfile: docker/Dockerfile
      target: dev
    image: [[project_name|lower]]:dev
    command: ["python", "-m", "pytest", "-v", "--tb=short"]
    environment:
      - [[python_package_name|upper]]_ENVIRONMENT=test
      - PYTEST_ADDOPTS=--color=yes
