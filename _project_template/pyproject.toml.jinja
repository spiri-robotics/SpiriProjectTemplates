[project]
name = "{{project_name}}"
version = "{{version}}"
description = "{{description}}"
readme = "README.md"
requires-python = ">=3.13"
{% if author_name -%}
authors = [{name = "{{author_name}}", email = "{{author_email}}"}]
{% endif -%}
license = "{{license}}"
dependencies = [
    "loguru>=0.7.3",
    "pydantic-settings>=2.14.2",
    "typer>=0.26.8",
{%- if spiri_config_plugin %}
    "rich>=14.1.0",
{% endif %}
]
{% if spiri_config_plugin -%}
{% if include_docs -%}

[project.optional-dependencies]
docs = ["sphinx>=9.1.0", "furo>=2024.0", "myst-parser>=5.1.0"]
spiriconfig = ["nicegui>=3.14.0"]
{% else -%}

[project.optional-dependencies]
spiriconfig = ["nicegui>=3.14.0"]
{% endif %}
{% elif include_docs -%}

[project.optional-dependencies]
docs = ["sphinx>=9.1.0", "furo>=2024.0", "myst-parser>=5.1.0"]
{% endif %}
{% if spiri_config_plugin -%}

[project.entry-points."spiriconfig.plugins"]
{{project_name}} = "{{python_package_name}}:{{python_package_name|replace("-", " ")|replace(".", " ")|replace("_", " ")|title|replace(" ", "")}}Plugin"
{% endif -%}
[project.scripts]
{{project_name}} = "{{python_package_name}}.cli:app"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{python_package_name}}"]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
asyncio_mode = "auto"

[dependency-groups]
dev = [
    "pytest>=9.1.1",
    "pytest-asyncio>=1.4.0",
    "pytest-cov>=7.1.0",
    "coverage>=7.0.0",
]
