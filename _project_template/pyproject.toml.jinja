[project]
name = "[[project_name]]"
version = "[[version]]"
description = "[[description]]"
readme = "README.md"
requires-python = ">=[[python_version]]"
[% if author_name %]
authors = [{name = "[[author_name]]"[% if author_email %], email = "[[author_email]]"[% endif %]}]
[% endif %]
license = "[[license]]"
[% if scaffold %]
dependencies = [
    "loguru>=0.7.3",
[% if spiri_config_plugin %]
    "nicegui>=3.19.0",
[% endif %]
    "pydantic-settings>=2.16.2",
[% if spirisynq %]
    "spirisynq>=0.6.0",
[% endif %]
    "typer>=0.27.3",
]
[% else %]
# The project's own: without starter code, the template has no dependencies to add.
dependencies = []
[% endif %]
[% if scaffold %]

[project.scripts]
[[project_name]] = "[[python_package_name]].cli:app"
[% endif %]
[% if has_package %]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/[[python_package_name]]"]
[% endif %]

[tool.uv]
[% if not has_package %]
# No Python package: this file pins the tools that lint the project and build its
# docs. uv installs the dependency groups and never tries to build the directory.
package = false
[% endif %]
# Without this, `uv run sphinx-build` in a fresh clone fails to find Sphinx: uv
# installs only the `dev` group unless told otherwise.
default-groups = ["dev"[% if include_docs %], "docs"[% endif %]]

[tool.pytest.ini_options]
testpaths = ["tests"]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "W", "I", "B", "UP", "N", "SIM"]
# N999: the package is named like the repo (SpiriGateway, SpiriCamera).
# B008: typer's idiom. SIM117: nested `with` blocks are how NiceGUI lays out a page.
ignore = ["N999", "B008", "SIM117"]

[dependency-groups]
dev = [
    "pytest>=9.2.0",
    "pytest-cov>=7.1.0",
    "ruff>=0.17.3",
]
[% if include_docs %]
docs = [
    "furo>=2025.12.19",
    "myst-parser>=5.1.0",
    "sphinx>=9.2.0",
    # Document control, PDF footer and naming, safety panels: the same extension
    # every Spiri manual uses. https://github.com/spiri-robotics/spiri-docs-tooling
    "spiri-docs>=0.2.0",
]
[% endif %]
